# =========================================================
# KY Intermediater's - Backend Environment Configuration
# =========================================================

# Database Configuration (Required for database operations)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ky?retryWrites=true&w=majority

# Admin Security
ADMIN_PASS=adminkypass
JWT_SECRET=super-secret-jwt-key-ky-intermediaters

# Express Backend Server Port
PORT=3000

# Email Automation (Nodemailer - Gmail / SMTP)
EMAIL_USER=admin@kyintermediaters.com
EMAIL_PASS=your-gmail-app-password

# Vercel Blob Storage (For Data Room confidential document uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Optional: SMS / WhatsApp Notifications (Twilio)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
